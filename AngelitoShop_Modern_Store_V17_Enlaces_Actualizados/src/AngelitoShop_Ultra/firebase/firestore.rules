// Reglas base para Firestore. Publica estas reglas desde Firebase Console.
// El cliente autenticado puede crear/actualizar su propio perfil y registrar actividad.
// Solo la cuenta administradora puede leer la colección de usuarios y actividad.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'maluvasa12@gmail.com'; }

    match /users/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /activity/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
